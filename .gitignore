# Generated
frontend/src/services/generated/

# Vendored offline toolchain (built by scripts/handoff-to-sandbox.sh), and files staged
# for deletion. Both get large and neither belongs in history.
toolchain/
_handoff/
_to_delete/

# Per-developer dev.sh answers, written by ./dev.sh
.prism-dev.conf

# Archives. A tarball in a repository is nearly always a snapshot of the repository,
# and committing one puts its whole weight in every future clone — permanently, since
# taking it out later means rewriting history rather than reverting a commit.
# Nothing of this type is tracked, so this excludes rather than hides anything.
*.tar
*.tar.gz
*.tgz
*.zip
